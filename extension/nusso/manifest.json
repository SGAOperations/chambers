{
  "manifest_version": 3,
  "name": "Chambers for NUSSO",
  "version": "1.0.0",
  "description": "Lets Chambers search and book NUSSO (nuevents.neu.edu) rooms from your own browser, with your own NUSSO sign-in, while you are on campus or the Northeastern VPN.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://nuevents.neu.edu/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://chambers.northeasternsga.com/*",
      "http://localhost/*"
    ]
  },
  "action": {
    "default_title": "Chambers for NUSSO"
  }
}
