# Neon Postgres (issue #136). The *pooled* connection string -- the host ending
# in -pooler -- which Better Auth and the live role checks use.
DATABASE_URL=

# Neon Data API (issue #136): every other query goes through it. The URL is the
# branch's Data API endpoint; the private key signs the server's short-lived
# chambers_server tokens and is as sensitive as the database password. Its
# public half must be in the JWKS file the branch's Data API trusts
# (public/data-api-jwks.json for dev and rehearsal, data-api-jwks-production.json
# for production).
NEON_DATA_API_URL=
DATA_API_PRIVATE_JWK=

# Better Auth (issue #136). The secret signs session cookies: at least 32 random
# characters, e.g. `openssl rand -base64 32`, different per environment.
# BETTER_AUTH_URL is this deployment's origin, e.g. https://chambers.northeasternsga.com
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
RESEND_API_KEY=
OPS_EMAIL=
RESEND_FROM_EMAIL=

# Where every email goes when this is not the production deployment.
#
# Recipients come out of the database -- a body's whole membership on a booking
# email, a user's own address on an invite -- so a preview or a local server
# pointed at real data would otherwise email real students. Outside production
# (VERCEL_ENV is not 'production') lib/resend.ts replaces every To, Cc and Bcc
# with this address and puts the intended recipients in the subject.
#
# Leave it empty and those emails are withheld and logged instead, which is the
# safe default: nothing is sent, and no RESEND_API_KEY is needed at all.
PREVIEW_EMAIL_RECIPIENT=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random string used to authenticate kiosk display pages (e.g. display_chambers_2026)
DISPLAY_KEY=
# Slack app credentials (from the Slack app's Basic Information page).
#
# The bot token needs chat:write to post committee meeting reminders, and the
# bot has to be invited to each committee's channel -- Slack answers a post to a
# channel it is not in with ok:false, not an HTTP error, so this fails quietly.
# Add chat:write.public if you would rather not invite it to each one.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Where Auto-Cancel sends its cancellation request. Leave empty in production:
# it falls back to cscreservations@northeastern.edu, which is the point of it.
#
# Outside production an empty value is REFUSED rather than defaulted, so a
# preview deployment or a local server has to name a test recipient here before
# it will send anything. Spell it exactly -- a misnamed variable reads as unset.
CSC_EMAIL=

# Shared secret for the scheduled routes, /api/cron/warm and
# /api/cron/slack-reminders. Both are driven by GitHub Actions, which send it as
# a bearer token, so it must also be set as a CRON_SECRET repo secret.
#
# /api/cron/warm only does trivial reads and still answers without it.
# /api/cron/slack-reminders writes and posts to Slack, so it refuses to run at
# all unless this is set.
CRON_SECRET=

# --- NUSSO / EMS (nuevents.neu.edu) integration (Browse/Book NUSSO tab) --------
# Chambers logs in to Northeastern's EMS Web App as one shared SGA web-user
# account (a plain username/password form -- no SSO redirect, no MFA) and drives
# its JSON API to browse spaces and create reservations. See docs/nusso-api.md.
#
# These are a real EMS login and are as sensitive as any other credential here.
# Leave them empty and the Browse/Book NUSSO tab returns "not configured" (503)
# rather than failing loudly.
NUSSO_USERNAME=
NUSSO_PASSWORD=

# Optional. Defaults to https://nuevents.neu.edu; override only to point at a
# different EMS host (e.g. a test instance).
NUSSO_BASE_URL=

# Optional overrides for SGA's EMS identifiers. The defaults are the values
# observed on nuevents.neu.edu and are baked into lib/nusso/config.ts; set these
# only if EMS renumbers them or a different group/template is wanted.
#   NUSSO_TEMPLATE_ID   room-request process template (default 25)
#   NUSSO_EVENT_TYPE_ID event type sent on the reservation (default 657)
#   NUSSO_GROUP_ID      SGA's EMS group id (default 225399)
#   NUSSO_TIME_ZONE_ID  EMS time-zone id for Eastern (default 61)
NUSSO_TEMPLATE_ID=
NUSSO_EVENT_TYPE_ID=
NUSSO_GROUP_ID=
NUSSO_TIME_ZONE_ID=

# Optional. The booking contact stamped on reservations (defaults to SGA ops).
NUSSO_CONTACT_NAME=
NUSSO_CONTACT_EMAIL=
NUSSO_CONTACT_PHONE=
