# Copy to relay.env on the USB stick (next to install.sh) and fill in.
# relay.env holds secrets: never commit it, and wipe the stick when done.

# Shared secret Chambers sends on every relay request. Generate once with
#   openssl rand -hex 32
# and put the same value in Vercel as NUSSO_RELAY_SECRET.
NUSSO_RELAY_SECRET=

# Tailscale auth key: admin console > Settings > Keys > Generate auth key,
# Reusable, Tags: tag:nusso-relay. One key works for both Pis.
TS_AUTHKEY=
